<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_calendar" model="ir.ui.view">
        <field name="name">hr.attendance.calendar</field>
        <field name="model">hr.attendance</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <calendar string="Attendances" 
                     date_start="check_in" 
                     date_stop="check_out" 
                     mode="month" 
                     color="employee_id"
                     show_unusual_days="True"
                     create="false">
                <field name="employee_id" filters="1" avatar_field="image_128"/>
                <field name="department_id" filters="1"/>
                <field name="worked_hours" widget="float_time"/>
            </calendar>
        </field>
    </record>

    <!-- Enhanced Search View -->
    <record id="hr_attendance_view_search_extended" model="ir.ui.view">
        <field name="name">hr.attendance.search.extended</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_filter"/>
        <field name="arch" type="xml">
            <!-- Add fields -->
            <field name="employee_id" position="after">
                <field name="department_id"/>
            </field>

            <!-- Add filters -->
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Yesterday" name="yesterday" 
                        domain="[('check_in', '&gt;=', (context_today() - datetime.timedelta(days=1)).strftime('%Y-%m-%d')),
                                ('check_in', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" 
                        domain="[('check_in', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last Week" name="last_week" 
                        domain="[('check_in', '&gt;=', (context_today() - datetime.timedelta(days=14)).strftime('%Y-%m-%d')),
                                ('check_in', '&lt;', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Late Check-in" name="late_check_in" 
                        domain="[('check_in::time', '&gt;=', '09:30:00')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="department" context="{'group_by': 'department_id'}"/>
                    <filter string="Date" name="date" context="{'group_by': 'check_in:day'}"/>
                    <filter string="Week" name="week" context="{'group_by': 'check_in:week'}"/>
                    <filter string="Month" name="month" context="{'group_by': 'check_in:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Update Action with Default Filters -->
    <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="context">{
            'search_default_month': 1,
            'search_default_department': 1
        }</field>
    </record>
</odoo>
